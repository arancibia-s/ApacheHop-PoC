  <transform>
    <type>TableInput</type>
    <name>staging.cruise_bookings_hop</name>
    <sql>SELECT 
	S.invoice_number
    ,last_invoice_status invoice_status
	,skin
	,agent_user_name agent
	,creation_datetime
	,cruise_confirmation_number AS cruise_confirmation_code
	,CASE WHEN cruise_vendor LIKE '%MSC%' THEN 'MSC Cruises' 
          WHEN cruise_vendor = 'PARADISE CRUISE LINE' THEN initcap(cruise_vendor)
		  ELSE cruise_vendor END AS cruise_line
	,cruise_transaction_commission cruise_commission
	,cruise_final_due_amount cruise_gross_booking
	,cruise_ship cruise_ship_name
	,cruise_days
	,customer_name customer_name  
    ,insurance_transaction_commission AS insurance_commission
	,insurance_final_due_amount AS insurance_gross_booking
    ,last_cruise_booking_status AS cruise_booking_status
	,cruise_creation_datetime
	,insurance_booking_status
	,insurance_confirmation_number insurance_confirmation_code
	,insurance_creation_datetime
	,insurance_vendor
    ,currency	
	,cruise_start_date cruise_begin_date
	,cruise_end_date
	,cruise_start_city
	,cruise_end_city
	,cruise_rate_option_code cruise_rate_code
	,cruise_rate_option_name cruise_rate_type
	,cruise_category_code cruise_category_code
    ,cruise_cabin_location
    ,last_revision_date AS revision_date
	,pin
	,member_id
	,number_of_passengers
	,total_invoice_amount AS invoice_total
    ,max_activation_date activation_date
    ,invoice_numbers_for_same_confirmation
	--,payment_platform_txn_id
	,CURRENT_TIMESTAMP AS etl_created_at
	,CURRENT_TIMESTAMP AS etl_updated_at

FROM 
(
    SELECT MAX(invoice_number) AS invoice_number
		,(ARRAY_AGG(invoice_status ORDER BY invoice_number DESC))[1] AS last_invoice_status
		,(ARRAY_AGG(cruise_booking_status ORDER BY invoice_number DESC))[1] AS last_cruise_booking_status
		,MAX(revision_datetime)::date AS last_revision_date
		,string_agg(DISTINCT invoice_number::varchar, ' | ' ) AS invoice_numbers_for_same_confirmation
		,MAX(activation_datetime )::date AS max_activation_date
    FROM staging.cruise_bookings_hop
    WHERE cruise_confirmation_number IS NOT NULL
    GROUP BY cruise_confirmation_number
) unique_cruise_confirmation_number
JOIN staging.cruise_bookings_hop S ON S.invoice_number = unique_cruise_confirmation_number.invoice_number

</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
