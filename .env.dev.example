# Copiá este archivo a ".env.dev" (ya está en .gitignore, nunca se commitea) y completá
# con los valores reales de la base de datos. Estos nombres son un ejemplo — deben
# coincidir con las variables que efectivamente usan las conexiones dentro del proyecto
# Hop (Metadata > Relational Database Connections), no hace falta que sean estos mismos.

DB_HOST=staging.example.internal
DB_PORT=5432
DB_NAME=cruise_bookings
DB_USER=hop_dev
DB_PASSWORD=changeme